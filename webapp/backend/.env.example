# 复制成 .env 再改。前缀统一 SHOPVISION_

# placeholder = 确定性占位编码器（先跑通链路，检索结果无意义）
# onnx        = 实验三双塔 ONNX
SHOPVISION_MODEL_BACKEND=placeholder

# 索引目录（相对仓库根）
SHOPVISION_INDEX_DIR=data/index_data_finetuned
SHOPVISION_CANDIDATE_K=50
SHOPVISION_MAX_UPLOAD_MB=10

# 增量入库：上传数据落 SQLite，上传原图落 upload_image_root（相对仓库根）。
# image_root 只服务静态清洗图；cleaning 目录不混入用户上传原图。
# 入库需要真实 ONNX；placeholder 模式会被拒绝（50001），避免占位向量污染索引。
SHOPVISION_DB_PATH=data/webapp.db
SHOPVISION_IMAGE_ROOT=data/processed_data_cleaning
SHOPVISION_UPLOAD_IMAGE_ROOT=data/uploaded_data
SHOPVISION_RAW_IMAGE_ROOT=data/raw_data
SHOPVISION_NEW_CATEGORY_MIN_ITEMS=1

# onnx 后端才用。产物从 GitHub Release 拉，见 docs/流程与交接/实验四模型产物上传说明.md
SHOPVISION_ONNX_VISUAL=data/optimize/2026-10-24_exp3-speed/onnx/visual_fp32.onnx
SHOPVISION_ONNX_TEXT=data/optimize/2026-10-24_exp3-speed/onnx/text_fp32.onnx
SHOPVISION_ONNX_PROVIDER=CPUExecutionProvider
SHOPVISION_ONNX_CONTEXT_LENGTH=52

# 前端 dev server 地址，跨域用
SHOPVISION_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 异步任务（/api/v1/tasks/*）的 Celery broker / result backend。
# 这里填的是组内共用的云 Redis（1.95.164.146:4141，Redis 7.0.15，支持 16 个 DB），
# 省得每人都去注册一个；换自己的把两条地址改掉即可。
# 云端 TLS 就用 rediss:// 前缀；队列用 /0，结果用 /1。
# 三个同步接口不依赖 Redis；Redis 不可达时只有异步提交接口报 50001。
SHOPVISION_CELERY_BROKER_URL=redis://default:L83iiexBrU1vkKH1aFJNjDCH@1.95.164.146:4141/0
SHOPVISION_CELERY_RESULT_BACKEND=redis://default:L83iiexBrU1vkKH1aFJNjDCH@1.95.164.146:4141/1
# 测试/无 Redis 冒烟：设 true 后任务在进程内同步执行（CI 用）
SHOPVISION_CELERY_ALWAYS_EAGER=false
SHOPVISION_CELERY_RESULT_EXPIRES=3600
SHOPVISION_ASYNC_BATCH_MAX_FILES=12