# 复制成 .env 再改。前缀统一 SHOPVISION_

# placeholder = 确定性占位编码器（先跑通链路，检索结果无意义）
# onnx        = 实验三双塔 ONNX
SHOPVISION_MODEL_BACKEND=placeholder

# 索引目录（相对仓库根）
SHOPVISION_INDEX_DIR=data/index_data_finetuned
SHOPVISION_CANDIDATE_K=50

# onnx 后端才用。产物从 GitHub Release 拉，见 docs/流程与交接/实验四模型产物上传说明.md
SHOPVISION_ONNX_VISUAL=data/optimize/2026-10-24_exp3-speed/onnx/visual_fp32.onnx
SHOPVISION_ONNX_TEXT=data/optimize/2026-10-24_exp3-speed/onnx/text_fp32.onnx
SHOPVISION_ONNX_PROVIDER=CPUExecutionProvider
SHOPVISION_ONNX_CONTEXT_LENGTH=52

# 前端 dev server 地址，跨域用
SHOPVISION_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]